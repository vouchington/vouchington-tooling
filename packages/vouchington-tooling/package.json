      "default": "./dist/http-origin/index.mjs"
    },
    "./process-line-buffer": {
      "types": "./dist/process-line-buffer/index.d.mts",
      "import": "./dist/process-line-buffer/index.mjs",
      "default": "./dist/process-line-buffer/index.mjs"
    },
    "./pg-schema-snapshot": {
      "types": "./dist/pg-schema-snapshot/index.d.mts",
      "import": "./dist/pg-schema-snapshot/index.mjs",
      "default": "./dist/pg-schema-snapshot/index.mjs"
    },
    "./openapi-document": {
      "types": "./dist/openapi-document/index.d.mts",
