{
  "name": "vouchington-tooling",
  "version": "0.0.6",
  "description": "Vouchington CLI and extractable tooling libraries.",
  "homepage": "https://github.com/vouchington/vouchington-tooling/tree/main/packages/vouchington-tooling#readme",
  "bugs": {
    "url": "https://github.com/vouchington/vouchington-tooling/issues"
  },
  "license": "MIT",
  "author": "Jonathan Ong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vouchington/vouchington-tooling.git",
    "directory": "packages/vouchington-tooling"
  },
  "bin": {
    "vouchington": "dist/cli/index.mjs"
  },
  "files": [
    "dist",
    "scripts",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./runner-port-policy": {
      "types": "./dist/runner-port-policy/index.d.mts",
      "import": "./dist/runner-port-policy/index.mjs",
      "default": "./dist/runner-port-policy/index.mjs"
    },
    "./sql-ast": {
      "types": "./dist/sql-ast/index.d.mts",
      "import": "./dist/sql-ast/index.mjs",
      "default": "./dist/sql-ast/index.mjs"
    },
    "./sql-scanner": {
      "types": "./dist/sql-scanner/index.d.mts",
      "import": "./dist/sql-scanner/index.mjs",
      "default": "./dist/sql-scanner/index.mjs"
    },
    "./gha-runtime-audit": {
      "types": "./dist/gha-runtime-audit/index.d.mts",
      "import": "./dist/gha-runtime-audit/index.mjs",
      "default": "./dist/gha-runtime-audit/index.mjs"
    },
    "./vitest-blob-manifest": {
      "types": "./dist/vitest-blob-manifest/index.d.mts",
      "import": "./dist/vitest-blob-manifest/index.mjs",
      "default": "./dist/vitest-blob-manifest/index.mjs"
    },
    "./pnpm-install": {
      "types": "./dist/pnpm-install/index.d.mts",
      "import": "./dist/pnpm-install/index.mjs",
      "default": "./dist/pnpm-install/index.mjs"
    },
    "./shared-context": {
      "types": "./dist/shared-context/index.d.mts",
      "import": "./dist/shared-context/index.mjs",
      "default": "./dist/shared-context/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "optionalDependencies": {
    "@libpg-query/parser": "^18.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
