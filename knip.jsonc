{
  "$schema": "https://unpkg.com/knip/schema.json",
  // pr-shepherd: agent CLI, not imported from source.
  // agent-blackboard: resolved from the repository root by this repository's `vouchington mcp`.
  "ignoreDependencies": ["agent-blackboard", "pr-shepherd"],
  // mise installs the pinned scc binary. It is not an npm package.
  // playwright is installed into the caller workspace by setup-playwright, not a repo dependency.
  "ignoreBinaries": ["mise", "pgrep", "playwright"],
  "workspaces": {
    "packages/vouchington-tooling": {
      // Loaded from the consumer package boundary only when the opt-in integration runs.
      "ignoreDependencies": ["vitest"],
      "entry": [
        "src/index.mts!",
        "src/agent-blackboard/index.mts!",
        "src/cli/index.mts!",
        "src/sql-ast/index.mts!",
        "src/sql-scanner/index.mts!",
        "src/gh-api-shell-quoting/index.mts!",
        "src/gha-runtime-audit/index.mts!",
        "src/vitest-blob-manifest/index.mts!",
        "src/vitest-blob-manifest/cli.mts!",
        "src/pnpm-install/index.mts!",
        "src/shared-context/index.mts!",
        "src/gha-selected-files/index.mts!",
        "src/gha-artifacts-cleanup/index.mts!",
        "src/agent-issue-labels/index.mts!",
        "src/http-origin/index.mts!",
        "src/provider-replay/index.mts!",
        "src/host-storage/index.mts!",
        "src/process-line-buffer/index.mts!",
        "src/shell-parse/index.mts!",
        "src/command-policy/index.mts!",
        "src/pg-schema-snapshot/index.mts!",
        "src/postgres-test-faults/index.mts!",
        "src/request-query-profile/index.mts!",
        "src/worker-query-profile/index.mts!",
        "src/openapi-document/index.mts!",
        "src/contract-schema/index.mts!",
        "src/api-fixtures/index.mts!",
        "src/vitest-diagnostics/index.mts!",
        "src/vitest-diagnostics/browser.mts!",
        "src/vitest-effective-timeout/index.mts!",
        "src/next-navigation-mock/index.mts!",
        "src/jsdom-stubs/index.mts!",
        "src/input-otp-mock/index.mts!",
        "src/playwright/index.mts!",
        "src/config-inventory/index.mts!",
        "src/finite-enum-ripple/index.mts!",
        "src/coverage-transport/index.mts!",
        "src/pnpm-deploy/index.mts!",
        "src/dockerfile-parse/index.mts!",
        "src/scc-complexity/index.mts!",
        "src/scc-complexity/repo-cli.mts!",
        "src/ci-local/index.mts!",
        "src/gha-rate-limit/index.mts!",
        "src/gha-pr-checkpoint/index.mts!",
        "src/gha-post-review/index.mts!",
        "src/gha-check-run/index.mts!",
        "src/workspace-gates/index.mts!",
        "src/dependency-license-policy/index.mts!",
        "src/nuget-central-version/index.mts!",
        "src/workflow-secrets-drift/index.mts!",
        "src/runner-policy/index.mts!",
        "src/tmux/index.mts!",
        "src/sandbox-command-audit/index.mts!",
        "src/cloc/index.mts!",
        "src/markdown-article-links/index.mts!",
        "src/coverage-scope/index.mts!",
        "src/trivy-policy/index.mts!",
        "src/docker-image-mirror/index.mts!",
        "src/workspace-registry-check/index.mts!",
        "src/storybook-browser-runner/index.mts!",
        "src/dead-code/index.mts!",
        "src/nuget-central-version/cli.mts!",
        "src/swift-semantic-equal/index.mts!",
        "src/swift-semantic-equal/cli.mts!",
        "src/swift-source-offset/index.mts!",
        "src/swift-resolved-pin-delta/index.mts!",
        "src/gh-cli/index.mts!",
        "src/fresh-base/index.mts!",
        "src/pull-request-diff/index.mts!",
        "src/workflow-policy/index.mts!",
        "src/compiler-build/index.mts!",
        "src/github-projects/index.mts!",
        "src/markdown/index.mts!",
        "src/basic-auth-doc-sync/index.mts!",
        "src/basic-auth-doc-sync/runbook.mts!",
        "src/post-publication-inventory/index.mts!",
        "src/retrospective-distill/index.mts!",
        "src/story-coverage/index.mts!",
        "src/transient-retry/index.mts!",
      ],
      "project": ["src/**/*.mts!", "!src/**/*.test.mts!", "!src/**/*.test-helpers.mts!"],
    },
    "packages/eslint-plugin-vouchington": {
      "entry": ["src/index.mts!"],
      "project": ["src/**/*.mts!", "!src/**/*.test.mts!", "!src/**/*.test-helpers.mts!"],
    },
  },
}
