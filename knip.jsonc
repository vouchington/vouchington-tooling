{
  "$schema": "https://unpkg.com/knip/schema.json",
  // eslint: peer of eslint-plugin-vouchington; imported only from plugin tests.
  // pr-shepherd: agent CLI, not imported from source.
  "ignoreDependencies": ["eslint", "pr-shepherd"],
  "workspaces": {
    "packages/vouchington-tooling": {
      // Loaded from the consumer package boundary only when the opt-in integration runs.
      "ignoreDependencies": ["agent-blackboard"],
      "entry": [
        "src/index.mts!",
        "src/cli/index.mts!",
        "src/sql-ast/index.mts!",
        "src/sql-scanner/index.mts!",
        "src/gh-api-shell-quoting/index.mts!",
        "src/gha-runtime-audit/index.mts!",
        "src/vitest-blob-manifest/index.mts!",
        "src/vitest-blob-manifest/cli.mts!",
        "src/pnpm-install/index.mts!",
        "src/shared-context/index.mts!",
        "src/gha-selected-files/index.mts!",
        "src/gha-artifacts-cleanup/index.mts!",
        "src/http-origin/index.mts!",
        "src/process-line-buffer/index.mts!",
        "src/pg-schema-snapshot/index.mts!",
        "src/openapi-document/index.mts!",
        "src/coverage-transport/index.mts!",
        "src/pnpm-deploy/index.mts!",
        "src/dockerfile-parse/index.mts!",
        "src/scc-complexity/index.mts!",
        "src/ci-local/index.mts!",
        "src/gha-rate-limit/index.mts!",
        "src/gha-pr-checkpoint/index.mts!",
        "src/gha-post-review/index.mts!",
        "src/workspace-gates/index.mts!",
        "src/nuget-central-version/index.mts!",
        "src/nuget-central-version/cli.mts!",
        "src/swift-semantic-equal/index.mts!",
        "src/swift-semantic-equal/cli.mts!",
        "src/swift-source-offset/index.mts!",
        "src/swift-resolved-pin-delta/index.mts!",
        "src/gh-cli/index.mts!",
      ],
      "project": ["src/**/*.mts!", "!src/**/*.test.mts!", "!src/**/*.test-helpers.mts!"],
    },
    "packages/eslint-plugin-vouchington": {
      "entry": ["src/index.mts!"],
      "project": ["src/**/*.mts!", "!src/**/*.test.mts!", "!src/**/*.test-helpers.mts!"],
    },
  },
}
