{
  "name": "vouchington-tooling-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Public Vouchington tooling: CLI, libraries, and house-style ESLint rules.",
  "homepage": "https://github.com/vouchington/vouchington-tooling#readme",
  "bugs": {
    "url": "https://github.com/vouchington/vouchington-tooling/issues"
  },
  "license": "MIT",
  "author": "Jonathan Ong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vouchington/vouchington-tooling.git"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "jscpd": "jscpd .",
    "lint": "pnpm run oxlint && pnpm run oxfmt:check && pnpm run knip && pnpm run dependency-cruiser && pnpm run jscpd",
    "oxlint": "oxlint --type-aware --deny-warnings",
    "oxlint:fix": "oxlint --type-aware --fix --deny-warnings",
    "oxfmt": "oxfmt",
    "oxfmt:check": "oxfmt --check",
    "knip": "knip",
    "dependency-cruiser": "depcruise packages",
    "actionlint": "github-actionlint -ignore 'property \"workflow_sha\" is not defined in object type'"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@vitest/coverage-v8": "^5.0.1",
    "dependency-cruiser": "^18.3.1",
    "eslint": "^10.10.0",
    "eslint-plugin-no-mistakes": "^0.62.1",
    "github-actionlint": "^1.7.12",
    "jscpd": "5.3.2",
    "knip": "^6.37.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "pr-shepherd": "^0.53.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
