{
  "mcpServers": {
    "vouchington-tooling": {
      "command": "bash",
      "args": [
        "-c",
        "exec node \"$(git rev-parse --show-toplevel)/packages/vouchington-tooling/src/cli/index.mts\" mcp"
      ],
      "env": {
        "AGENT_BLACKBOARD_URL": "${AGENT_BLACKBOARD_URL}",
        "AGENT_BLACKBOARD_TOKEN": "${AGENT_BLACKBOARD_TOKEN}"
      }
    }
  }
}
